<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.LivingAI" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/colorTextOnPrimary</item>
        
        <!-- Secondary brand colors -->
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSecondaryVariant">@color/colorSecondaryDark</item>
        <item name="colorOnSecondary">@color/colorTextOnSecondary</item>
        
        <!-- Surface colors -->
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorTextPrimary</item>
        
        <!-- Background color -->
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorBackground">@color/colorBackground</item>
        <item name="colorOnBackground">@color/colorTextPrimary</item>
        
        <!-- Error colors -->
        <item name="colorError">@color/colorError</item>
        <item name="colorOnError">@color/colorTextOnPrimary</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/colorStatusBar</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Window background -->
        <item name="android:windowBackground">@color/colorBackground</item>
        
        <!-- Font family -->
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Splash theme -->
    <style name="Theme.LivingAI.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/colorSplashBackground</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/colorSplashBackground</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Dark theme -->
    <style name="Theme.LivingAI.Dark" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/colorTextOnPrimary</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSecondaryVariant">@color/colorSecondaryDark</item>
        <item name="colorOnSecondary">@color/colorTextOnSecondary</item>
        <item name="colorSurface">@color/colorSurfaceDark</item>
        <item name="colorOnSurface">@color/colorTextPrimaryDark</item>
        <item name="android:colorBackground">@color/colorBackgroundDark</item>
        <item name="colorBackground">@color/colorBackgroundDark</item>
        <item name="colorOnBackground">@color/colorTextPrimaryDark</item>
        <item name="colorError">@color/colorErrorDark</item>
        <item name="colorOnError">@color/colorTextOnPrimary</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/colorStatusBarDark</item>
        <item name="android:windowBackground">@color/colorBackgroundDark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Light theme -->
    <style name="Theme.LivingAI.Light" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/colorTextOnPrimary</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSecondaryVariant">@color/colorSecondaryDark</item>
        <item name="colorOnSecondary">@color/colorTextOnSecondary</item>
        <item name="colorSurface">@color/colorSurfaceLight</item>
        <item name="colorOnSurface">@color/colorTextPrimary</item>
        <item name="android:colorBackground">@color/colorBackgroundLight</item>
        <item name="colorBackground">@color/colorBackgroundLight</item>
        <item name="colorOnBackground">@color/colorTextPrimary</item>
        <item name="colorError">@color/colorError</item>
        <item name="colorOnError">@color/colorTextOnPrimary</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/colorStatusBarLight</item>
        <item name="android:windowBackground">@color/colorBackgroundLight</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- AppCompat theme for dialogs -->
    <style name="Theme.LivingAI.AppCompat" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/colorStatusBar</item>
    </style>

    <!-- Text styles -->
    <style name="TextAppearance.LivingAI.Title">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.LivingAI.Subtitle">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/colorTextSecondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.LivingAI.Body">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.LivingAI.Caption">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/colorTextSecondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.LivingAI.Button">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/colorButtonText</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Button styles -->
    <style name="Widget.LivingAI.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/colorButtonPrimary</item>
        <item name="android:textColor">@color/colorButtonText</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.LivingAI.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:backgroundTint">@color/colorTransparent</item>
        <item name="android:textColor">@color/colorButtonSecondary</item>
        <item name="strokeColor">@color/colorButtonSecondary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.LivingAI.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/colorButtonSecondary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Card styles -->
    <style name="Widget.LivingAI.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/colorCardBackground</item>
        <item name="cardElevation">8dp</item>
        <item name="cardCornerRadius">8dp</item>
    </style>

    <!-- TextInputLayout styles -->
    <style name="Widget.LivingAI.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/colorPrimary</item>
        <item name="hintTextColor">@color/colorTextSecondary</item>
        <item name="android:textColorHint">@color/colorTextSecondary</item>
    </style>

    <!-- FloatingActionButton styles -->
    <style name="Widget.LivingAI.FloatingActionButton" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="tint">@color/colorTextOnPrimary</item>
    </style>

    <!-- Toolbar styles -->
    <style name="Widget.LivingAI.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">@color/colorPrimary</item>
        <item name="android:minHeight">?attr/actionBarSize</item>
        <item name="titleTextColor">@color/colorTextOnPrimary</item>
        <item name="subtitleTextColor">@color/colorTextOnPrimary</item>
        <item name="navigationIconTint">@color/colorTextOnPrimary</item>
    </style>

    <!-- BottomNavigationView styles -->
    <style name="Widget.LivingAI.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/colorSurface</item>
        <item name="itemIconTint">@color/colorIcon</item>
        <item name="itemTextColor">@color/colorIcon</item>
        <item name="itemRippleColor">@color/colorPrimaryLight</item>
    </style>

    <!-- NavigationView styles -->
    <style name="Widget.LivingAI.NavigationView" parent="Widget.MaterialComponents.NavigationView">
        <item name="android:background">@color/colorSurface</item>
        <item name="itemIconTint">@color/colorIcon</item>
        <item name="itemTextColor">@color/colorTextPrimary</item>
        <item name="itemBackground">@drawable/nav_item_background</item>
    </style>

    <!-- RecyclerView styles -->
    <style name="Widget.LivingAI.RecyclerView" parent="Widget.AppCompat.RecyclerView">
        <item name="android:clipToPadding">false</item>
        <item name="android:padding">8dp</item>
    </style>

    <!-- ProgressBar styles -->
    <style name="Widget.LivingAI.ProgressBar" parent="Widget.AppCompat.ProgressBar">
        <item name="android:indeterminateTint">@color/colorPrimary</item>
    </style>

    <style name="Widget.LivingAI.ProgressBar.Horizontal" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:progressTint">@color/colorPrimary</item>
        <item name="android:progressBackgroundTint">@color/colorPrimaryLight</item>
    </style>

    <!-- Switch styles -->
    <style name="Widget.LivingAI.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="trackTint">@color/colorPrimaryLight</item>
        <item name="thumbTint">@color/colorPrimary</item>
    </style>

    <!-- CheckBox styles -->
    <style name="Widget.LivingAI.CheckBox" parent="Widget.MaterialComponents.CompoundButton.CheckBox">
        <item name="buttonTint">@color/colorPrimary</item>
    </style>

    <!-- RadioButton styles -->
    <style name="Widget.LivingAI.RadioButton" parent="Widget.MaterialComponents.CompoundButton.RadioButton">
        <item name="buttonTint">@color/colorPrimary</item>
    </style>

    <!-- Chip styles -->
    <style name="Widget.LivingAI.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/colorPrimaryLight</item>
        <item name="chipStrokeColor">@color/colorPrimary</item>
        <item name="android:textColor">@color/colorPrimary</item>
    </style>

    <!-- TabLayout styles -->
    <style name="Widget.LivingAI.TabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabIndicatorColor">@color/colorPrimary</item>
        <item name="tabTextColors">@color/tab_text_colors</item>
        <item name="tabSelectedTextColor">@color/colorPrimary</item>
    </style>

    <!-- Dialog styles -->
    <style name="Theme.LivingAI.Dialog" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="android:windowBackground">@color/colorSurface</item>
        <item name="android:colorBackground">@color/colorSurface</item>
    </style>

    <style name="Theme.LivingAI.Dialog.Alert" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/colorTextOnPrimary</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorTextPrimary</item>
    </style>

    <!-- Terminal styles -->
    <style name="Widget.LivingAI.Terminal">
        <item name="android:background">@color/colorTerminalBackground</item>
        <item name="android:textColor">@color/colorTerminalText</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <!-- Status indicator styles -->
    <style name="Widget.LivingAI.StatusIndicator.Active">
        <item name="android:background">@color/colorAgentActive</item>
    </style>

    <style name="Widget.LivingAI.StatusIndicator.Inactive">
        <item name="android:background">@color/colorAgentInactive</item>
    </style>

    <style name="Widget.LivingAI.StatusIndicator.Paused">
        <item name="android:background">@color/colorAgentPaused</item>
    </style>

    <style name="Widget.LivingAI.StatusIndicator.Error">
        <item name="android:background">@color/colorAgentError</item>
    </style>
</resources>
