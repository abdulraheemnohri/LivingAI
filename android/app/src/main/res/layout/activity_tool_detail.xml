<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".activities.ToolDetailActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorPrimary"
        android:elevation="@dimen/elevation_level_2"
        android:theme="@style/Theme.LivingAI"
        app:popupTheme="@style/Theme.LivingAI"
        app:title="@string/title_tool_detail"
        app:titleTextColor="@color/colorTextOnPrimary" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Tool Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorSecondary"
                android:orientation="vertical"
                android:padding="@dimen/spacing_xl">

                <ImageView
                    android:id="@+id/tool_detail_icon"
                    android:layout_width="@dimen/image_size_xxl"
                    android:layout_height="@dimen/image_size_xxl"
                    android:src="@drawable/ic_tool"
                    android:tint="@color/colorTextOnPrimary"
                    android:layout_gravity="center_horizontal" />

                <TextView
                    android:id="@+id/tool_detail_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tool Name"
                    android:textColor="@color/colorTextOnPrimary"
                    android:textSize="@dimen/text_size_xxl"
                    android:textStyle="bold"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:layout_gravity="center_horizontal" />

                <TextView
                    android:id="@+id/tool_detail_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Category"
                    android:textColor="@color/colorTextOnPrimary"
                    android:textSize="@dimen/text_size_md"
                    android:alpha="0.8"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:layout_gravity="center_horizontal" />
            </LinearLayout>

            <!-- Tool Info Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_md"
                app:cardCornerRadius="@dimen/corner_radius_md"
                app:cardElevation="@dimen/elevation_level_2">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tool_detail_description"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="@dimen/text_size_lg"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tool_detail_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tool description"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="@dimen/text_size_md"
                        android:layout_marginTop="@dimen/spacing_xs" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/colorDivider"
                        android:layout_marginVertical="@dimen/spacing_md" />

                    <!-- Tool Stats -->
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="3"
                        android:rowCount="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_rowWeight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_sm">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tool_detail_version"
                                android:textColor="@color/colorTextSecondary"
                                android:textSize="@dimen/text_size_xs" />

                            <TextView
                                android:id="@+id/tool_detail_version_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1.0"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="@dimen/text_size_md"
                                android:textStyle="bold"
                                android:layout_marginTop="@dimen/spacing_xs" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_rowWeight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_sm">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tool_detail_author"
                                android:textColor="@color/colorTextSecondary"
                                android:textSize="@dimen/text_size_xs" />

                            <TextView
                                android:id="@+id/tool_detail_author_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Author"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="@dimen/text_size_md"
                                android:textStyle="bold"
                                android:layout_marginTop="@dimen/spacing_xs" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_rowWeight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_sm">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tool_detail_status"
                                android:textColor="@color/colorTextSecondary"
                                android:textSize="@dimen/text_size_xs" />

                            <TextView
                                android:id="@+id/tool_detail_status_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Enabled"
                                android:textColor="@color/colorSuccess"
                                android:textSize="@dimen/text_size_md"
                                android:textStyle="bold"
                                android:layout_marginTop="@dimen/spacing_xs" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_rowWeight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_sm">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Category"
                                android:textColor="@color/colorTextSecondary"
                                android:textSize="@dimen/text_size_xs" />

                            <TextView
                                android:id="@+id/tool_detail_category_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="AI"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="@dimen/text_size_md"
                                android:textStyle="bold"
                                android:layout_marginTop="@dimen/spacing_xs" />
                        </LinearLayout>
                    </GridLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Parameters Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tool_detail_parameters"
                android:textColor="@color/colorTextPrimary"
                android:textSize="@dimen/text_size_lg"
                android:textStyle="bold"
                android:layout_margin="@dimen/spacing_md" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_md"
                app:cardCornerRadius="@dimen/corner_radius_md"
                app:cardElevation="@dimen/elevation_level_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/tool_detail_parameters_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Usage Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tool_detail_usage"
                android:textColor="@color/colorTextPrimary"
                android:textSize="@dimen/text_size_lg"
                android:textStyle="bold"
                android:layout_margin="@dimen/spacing_md" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_md"
                app:cardCornerRadius="@dimen/corner_radius_md"
                app:cardElevation="@dimen/elevation_level_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:id="@+id/tool_detail_usage_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Usage instructions"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="@dimen/text_size_md" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Examples Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tool_detail_examples"
                android:textColor="@color/colorTextPrimary"
                android:textSize="@dimen/text_size_lg"
                android:textStyle="bold"
                android:layout_margin="@dimen/spacing_md" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_md"
                app:cardCornerRadius="@dimen/corner_radius_md"
                app:cardElevation="@dimen/elevation_level_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:id="@+id/tool_detail_examples_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Example usage"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="@dimen/text_size_md" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tool_detail_test"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tool_detail_test"
                    app:backgroundTint="@color/colorPrimary"
                    app:cornerRadius="@dimen/corner_radius_md"
                    app:icon="@drawable/ic_test"
                    app:iconTint="@color/colorTextOnPrimary" />

                <Space
                    android:layout_width="@dimen/spacing_sm"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tool_detail_enable"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tool_detail_enable"
                    app:backgroundTint="@color/colorSuccess"
                    app:cornerRadius="@dimen/corner_radius_md"
                    app:icon="@drawable/ic_check"
                    app:iconTint="@color/colorTextOnPrimary" />

                <Space
                    android:layout_width="@dimen/spacing_sm"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tool_detail_disable"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tool_detail_disable"
                    app:backgroundTint="@color/colorError"
                    app:cornerRadius="@dimen/corner_radius_md"
                    app:icon="@drawable/ic_close"
                    app:iconTint="@color/colorTextOnPrimary" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
