<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".activities.ToolsActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorPrimary"
        android:elevation="@dimen/elevation_level_2"
        android:theme="@style/Theme.LivingAI"
        app:popupTheme="@style/Theme.LivingAI"
        app:title="@string/title_tools"
        app:titleTextColor="@color/colorTextOnPrimary" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <!-- Search Bar -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:hint="@string/tools_search_hint"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusTopStart="@dimen/corner_radius_md"
                app:boxCornerRadiusTopEnd="@dimen/corner_radius_md"
                app:boxCornerRadiusBottomStart="@dimen/corner_radius_md"
                app:boxCornerRadiusBottomEnd="@dimen/corner_radius_md"
                app:strokeColor="@color/colorPrimary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tools_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Categories -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tools_categories"
                android:textColor="@color/colorTextPrimary"
                android:textSize="@dimen/text_size_lg"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <!-- Category Chips -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/tools_categories_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/tools_category_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tools_all"
                    app:chipBackgroundColor="@color/colorPrimaryLight"
                    app:chipStrokeColor="@color/colorPrimary" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/tools_category_ai"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tool_category_ai"
                    app:chipBackgroundColor="@color/colorTransparent"
                    app:chipStrokeColor="@color/colorToolAI" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/tools_category_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tool_category_code"
                    app:chipBackgroundColor="@color/colorTransparent"
                    app:chipStrokeColor="@color/colorToolCode" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/tools_category_data"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tool_category_data"
                    app:chipBackgroundColor="@color/colorTransparent"
                    app:chipStrokeColor="@color/colorToolData" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/tools_category_system"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tool_category_system"
                    app:chipBackgroundColor="@color/colorTransparent"
                    app:chipStrokeColor="@color/colorToolSystem" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/tools_category_utility"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tool_category_utility"
                    app:chipBackgroundColor="@color/colorTransparent"
                    app:chipStrokeColor="@color/colorToolUtility" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/tools_category_network"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tool_category_network"
                    app:chipBackgroundColor="@color/colorTransparent"
                    app:chipStrokeColor="@color/colorToolNetwork" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/tools_category_file"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tool_category_file"
                    app:chipBackgroundColor="@color/colorTransparent"
                    app:chipStrokeColor="@color/colorToolFile" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/tools_category_database"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tool_category_database"
                    app:chipBackgroundColor="@color/colorTransparent"
                    app:chipStrokeColor="@color/colorToolDatabase" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Tools List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tools_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/tools_empty_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/image_size_xxl"
                    android:layout_height="@dimen/image_size_xxl"
                    android:src="@drawable/ic_tool"
                    android:tint="@color/colorIconInactive" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tools_no_tools"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="@dimen/text_size_lg"
                    android:layout_marginTop="@dimen/spacing_md" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
