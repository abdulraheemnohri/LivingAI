<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/margin_small"
    app:cardBackgroundColor="@color/colorSurfaceVariant"
    app:cardCornerRadius="@dimen/corner_radius_medium"
    app:cardElevation="@dimen/elevation_small">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/padding_medium">

        <!-- Memory Icon -->
        <ImageView
            android:id="@+id/ivMemoryIcon"
            android:layout_width="@dimen/icon_size_medium"
            android:layout_height="@dimen/icon_size_medium"
            android:layout_marginEnd="@dimen/margin_medium"
            android:src="@drawable/ic_memory"
            android:tint="@color/colorPrimary" />

        <!-- Memory Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMemoryType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/memory_type"
                android:textColor="@color/colorOnSurface"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMemoryContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_tiny"
                android:text="@string/memory_content"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="@dimen/text_size_small"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvMemoryTimestamp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_tiny"
                android:text="@string/memory_timestamp"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="@dimen/text_size_small" />
        </LinearLayout>

        <!-- Memory Actions -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditMemory"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_tiny"
                app:icon="@drawable/ic_edit"
                app:iconTint="@color/colorPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteMemory"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_delete"
                app:iconTint="@color/colorError" />
        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>
