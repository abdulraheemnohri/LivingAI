<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".activities.SettingsActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorPrimary"
        android:elevation="@dimen/elevation_level_2"
        android:theme="@style/Theme.LivingAI"
        app:popupTheme="@style/Theme.LivingAI"
        app:title="@string/title_settings"
        app:titleTextColor="@color/colorTextOnPrimary" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <!-- General Settings -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_general"
                android:textColor="@color/colorTextPrimary"
                android:textSize="@dimen/text_size_lg"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardCornerRadius="@dimen/corner_radius_md"
                app:cardElevation="@dimen/elevation_level_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Language -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/spacing_md"
                        android:hint="@string/settings_language"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="@dimen/corner_radius_md"
                        app:boxCornerRadiusTopEnd="@dimen/corner_radius_md"
                        app:boxCornerRadiusBottomStart="@dimen/corner_radius_md"
                        app:boxCornerRadiusBottomEnd="@dimen/corner_radius_md">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/settings_language"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:completionThreshold="1"
                            android:inputType="textNoSuggestions" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Theme -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_marginEnd="@dimen/spacing_md"
                        android:layout_marginBottom="@dimen/spacing_md"
                        android:hint="@string/settings_theme"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="@dimen/corner_radius_md"
                        app:boxCornerRadiusTopEnd="@dimen/corner_radius_md"
                        app:boxCornerRadiusBottomStart="@dimen/corner_radius_md"
                        app:boxCornerRadiusBottomEnd="@dimen/corner_radius_md">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/settings_theme"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:completionThreshold="1"
                            android:inputType="textNoSuggestions" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Appearance Settings -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_appearance"
                android:textColor="@color/colorTextPrimary"
                android:textSize="@dimen/text_size_lg"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardCornerRadius="@dimen/corner_radius_md"
                app:cardElevation="@dimen/elevation_level_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Auto Update -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/settings_auto_update"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/spacing_md"
                        android:text="@string/settings_auto_update"
                        android:textColor="@color/colorTextPrimary" />

                    <!-- Analytics -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/settings_analytics_enabled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/spacing_md"
                        android:text="@string/settings_analytics_enabled"
                        android:textColor="@color/colorTextPrimary" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Notifications Settings -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_notifications"
                android:textColor="@color/colorTextPrimary"
                android:textSize="@dimen/text_size_lg"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardCornerRadius="@dimen/corner_radius_md"
                app:cardElevation="@dimen/elevation_level_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Notifications Enabled -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/settings_notifications_enabled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/spacing_md"
                        android:text="@string/settings_notifications_enabled"
                        android:textColor="@color/colorTextPrimary" />

                    <!-- Notification Sound -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/settings_notifications_sound"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/spacing_md"
                        android:text="@string/settings_notifications_sound"
                        android:textColor="@color/colorTextPrimary" />

                    <!-- Vibration -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/settings_notifications_vibration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/spacing_md"
                        android:text="@string/settings_notifications_vibration"
                        android:textColor="@color/colorTextPrimary" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Storage Settings -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_storage"
                android:textColor="@color/colorTextPrimary"
                android:textSize="@dimen/text_size_lg"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardCornerRadius="@dimen/corner_radius_md"
                app:cardElevation="@dimen/elevation_level_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Clear Cache -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settings_clear_cache"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/spacing_md"
                        android:text="@string/settings_clear_cache"
                        app:backgroundTint="@color/colorError"
                        app:cornerRadius="@dimen/corner_radius_md" />

                    <!-- Clear History -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settings_clear_history"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/spacing_md"
                        android:text="@string/settings_clear_history"
                        app:backgroundTint="@color/colorError"
                        app:cornerRadius="@dimen/corner_radius_md" />

                    <!-- Reset App -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settings_reset_app"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/spacing_md"
                        android:text="@string/settings_reset_app"
                        app:backgroundTint="@color/colorError"
                        app:cornerRadius="@dimen/corner_radius_md" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- About Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_about"
                android:textColor="@color/colorTextPrimary"
                android:textSize="@dimen/text_size_lg"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardCornerRadius="@dimen/corner_radius_md"
                app:cardElevation="@dimen/elevation_level_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Version -->
                    <TextView
                        android:id="@+id/settings_version"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/spacing_md"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="@dimen/text_size_md" />

                    <!-- GitHub -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settings_github"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/spacing_md"
                        android:text="@string/about_github"
                        app:backgroundTint="@color/colorPrimary"
                        app:cornerRadius="@dimen/corner_radius_md" />

                    <!-- Contact -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settings_contact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/spacing_md"
                        android:text="@string/about_contact"
                        app:backgroundTint="@color/colorSecondary"
                        app:cornerRadius="@dimen/corner_radius_md" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
