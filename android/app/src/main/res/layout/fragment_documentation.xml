<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorSurface"
    android:padding="@dimen/padding_medium"
    tools:context=".ui.documentation.DocumentationFragment">

    <!-- Documentation Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarDocumentation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurfaceVariant"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/documentation"
        app:titleTextColor="@color/colorOnSurface">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSearchDocs"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_search"
            app:iconTint="@color/colorOnSurface" />
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Documentation Categories -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDocCategories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_medium"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@+id/toolbarDocumentation"
        app:spanCount="2"
        tools:listitem="@layout/item_doc_category" />

    <!-- Documentation Content -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDocumentation"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/margin_medium"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/btnOpenExternalDocs"
        app:layout_constraintTop_toBottomOf="@+id/rvDocCategories"
        tools:listitem="@layout/item_documentation" />

    <!-- External Documentation Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenExternalDocs"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:text="@string/open_external_docs"
        android:textAllCaps="false"
        app:icon="@drawable/ic_share"
        app:iconTint="@color/colorPrimary"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/llEmptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="@dimen/icon_size_large"
            android:layout_height="@dimen/icon_size_large"
            android:layout_marginBottom="@dimen/margin_medium"
            android:src="@drawable/ic_documentation"
            android:tint="@color/colorOnSurfaceVariant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_documentation"
            android:textColor="@color/colorOnSurfaceVariant"
            android:textSize="@dimen/text_size_large" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:text="@string/check_back_later"
            android:textColor="@color/colorOnSurfaceVariant"
            android:textSize="@dimen/text_size_medium" />
    </LinearLayout>

    <!-- Loading State -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
